---
import '../styles/globals.css';
import '@fontsource-variable/inter/wght.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Nav from '../components/site/Nav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'Higgsfield — The AI-native creative suite',
    description = 'Generate cinematic video, striking images and lifelike voice from a single prompt. Every leading model, one seamless creative workspace.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta name="theme-color" content="#000000" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    </head>
    <body class="min-h-screen bg-black font-sans text-white antialiased selection:bg-fuchsia-500/30">
        <div class="relative overflow-x-clip">
            <Nav />
            <main><slot /></main>
            <SiteFooter />
        </div>
    </body>
</html>
