---
import '../styles/globals.css';
import '@fontsource-variable/inter/wght.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import AnimatedBackground from '../components/sell/AnimatedBackground.astro';

interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'NovaPro — Sell anything, 10× faster.',
    description = 'The all-in-one platform that turns visitors into paying customers. Beautiful pages, smart checkout, zero code.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta name="theme-color" content="#05060a" />
        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    </head>
    <body class="antialiased text-[color:var(--color-sell-text)] bg-[color:var(--color-sell-bg)] overflow-x-hidden">
        <AnimatedBackground />
        <slot />

        <!-- Scroll reveal observer (global, runs once per page) -->
        <script is:inline>
            (() => {
                const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                const els = document.querySelectorAll('.sell-reveal');
                if (reduce || !('IntersectionObserver' in window)) {
                    els.forEach((el) => el.classList.add('is-visible'));
                    return;
                }
                const io = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('is-visible');
                                io.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
                );
                els.forEach((el) => io.observe(el));
            })();
        </script>
    </body>
</html>
