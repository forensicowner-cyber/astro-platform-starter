---
import Reveal from './Reveal.astro';

const pains = [
    { icon: '⏰', title: 'Spending weeks on a website', desc: "Coding, design, deploys… and it still doesn't convert." },
    { icon: '💸', title: 'Losing sales at checkout', desc: 'Slow forms, broken payments, abandoned carts everywhere.' },
    { icon: '🧩', title: 'Stitching 10 tools together', desc: 'Pages here, payments there, analytics nowhere.' }
];
---

<section class="sell-section">
    <div class="sell-container">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <Reveal><span class="sell-eyebrow">The problem</span></Reveal>
            <Reveal delay={1}>
                <h2 class="mt-5 text-3xl sm:text-5xl font-bold text-white">
                    Building an online store shouldn't feel like <span class="sell-gradient-text">solving a puzzle.</span>
                </h2>
            </Reveal>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
            {pains.map((p, i) => (
                <Reveal delay={(i + 1) as 1|2|3}>
                    <div class="sell-card p-7 text-left h-full">
                        <span class="sell-card-glow"></span>
                        <div class="text-3xl mb-4">{p.icon}</div>
                        <h3 class="text-xl font-semibold text-white mb-2">{p.title}</h3>
                        <p class="text-[color:var(--color-sell-muted)]">{p.desc}</p>
                    </div>
                </Reveal>
            ))}
        </div>
    </div>
</section>
