---
import Reveal from './Reveal.astro';

const steps = [
    { n: '01', title: 'Pick a template', desc: 'Choose from 80+ pre-designed, conversion-optimized templates.' },
    { n: '02', title: 'Customize in minutes', desc: 'Drag, drop, and edit. Add your products, pricing, and brand colors.' },
    { n: '03', title: 'Launch & start selling', desc: 'Connect your domain, hit publish — start accepting orders the same day.' }
];
---

<section id="how" class="sell-section">
    <div class="sell-container">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <Reveal><span class="sell-eyebrow">How it works</span></Reveal>
            <Reveal delay={1}>
                <h2 class="mt-5 text-3xl sm:text-5xl font-bold text-white">
                    From idea to <span class="sell-gradient-text">first sale</span> in 3 steps.
                </h2>
            </Reveal>
        </div>

        <div class="relative grid md:grid-cols-3 gap-6">
            <div class="hidden md:block absolute top-12 left-[16%] right-[16%] h-px bg-gradient-to-r from-transparent via-[color:var(--color-sell-accent)] to-transparent opacity-40"></div>
            {steps.map((s, i) => (
                <Reveal delay={(i + 1) as 1|2|3}>
                    <div class="relative text-center">
                        <div class="sell-step-num">{s.n}</div>
                        <h3 class="mt-6 text-xl font-semibold text-white">{s.title}</h3>
                        <p class="mt-3 text-[color:var(--color-sell-muted)]">{s.desc}</p>
                    </div>
                </Reveal>
            ))}
        </div>
    </div>
</section>

<style>
    .sell-step-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        margin: 0 auto;
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, #7c5cff, #f472b6);
        border-radius: 1rem;
        box-shadow: 0 12px 30px -10px rgba(124, 92, 255, 0.6);
        position: relative;
        z-index: 1;
    }
</style>
