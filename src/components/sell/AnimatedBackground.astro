---
// Decorative animated background: floating orbs + grid mask
---

<div class="sell-bg-wrap" aria-hidden="true">
    <div class="sell-grid-bg absolute inset-0"></div>
    <div class="sell-orb sell-orb-1"></div>
    <div class="sell-orb sell-orb-2"></div>
    <div class="sell-orb sell-orb-3"></div>
</div>

<style>
    .sell-bg-wrap {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        background: radial-gradient(ellipse at top, #0a0d1f 0%, #05060a 60%);
    }

    .sell-orb-1 {
        width: 520px;
        height: 520px;
        background: #7c5cff;
        top: -120px;
        left: -120px;
        animation-delay: 0s;
    }

    .sell-orb-2 {
        width: 480px;
        height: 480px;
        background: #22d3ee;
        top: 30%;
        right: -160px;
        animation-delay: -5s;
    }

    .sell-orb-3 {
        width: 460px;
        height: 460px;
        background: #f472b6;
        bottom: -160px;
        left: 30%;
        animation-delay: -9s;
        opacity: 0.4;
    }
</style>
