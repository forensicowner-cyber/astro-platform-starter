---
import Reveal from './Reveal.astro';
---

<section class="sell-section">
    <div class="sell-container">
        <Reveal>
            <div class="sell-cta-box">
                <div class="sell-cta-glow"></div>
                <h2 class="text-3xl sm:text-5xl font-bold text-white max-w-2xl">
                    Ready to make your first sale?
                </h2>
                <p class="mt-4 text-lg text-white/70 max-w-xl">
                    Join 12,000+ founders already growing with NovaPro. Free for 14 days. No credit card.
                </p>
                <div class="flex flex-col sm:flex-row gap-3 mt-8">
                    <a href="/checkout?plan=growth" class="sell-btn sell-btn-lg">
                        Start your free trial
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                    </a>
                    <a href="#faq" class="sell-btn-ghost">Have a question?</a>
                </div>
            </div>
        </Reveal>
    </div>
</section>

<style>
    .sell-cta-box {
        position: relative;
        padding: 4rem 2.5rem;
        border-radius: 1.5rem;
        background: linear-gradient(135deg, rgba(124, 92, 255, 0.15), rgba(244, 114, 182, 0.08));
        border: 1px solid rgba(124, 92, 255, 0.3);
        overflow: hidden;
    }

    .sell-cta-glow {
        position: absolute;
        inset: -50%;
        background: radial-gradient(circle at 30% 30%, rgba(124, 92, 255, 0.5), transparent 50%);
        animation: sell-float 12s ease-in-out infinite;
        pointer-events: none;
    }

    .sell-cta-box > * {
        position: relative;
        z-index: 1;
    }

    .sell-btn-lg {
        padding: 1.1rem 1.8rem;
        font-size: 1rem;
    }

    @media (min-width: 640px) {
        .sell-cta-box {
            padding: 5rem 4rem;
        }
    }
</style>
