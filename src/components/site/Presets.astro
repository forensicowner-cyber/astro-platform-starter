---
import Tile from './Tile.astro';

const presets = [
    { label: 'Drift Racing', sub: 'Motion', grad: 'hf-g1', img: '/media/hero-drift.jpg', badge: '▶ Preset' },
    { label: 'Storm Giant', sub: 'VFX', grad: 'hf-g6', img: '/media/hero-storm.jpg', badge: '▶ Preset' },
    { label: 'Kung-Fu Hit', sub: 'Action', grad: 'hf-g7', img: '/media/pre-kungfu.jpg', badge: '▶ Preset' },
    { label: '2000s Paparazzi', sub: 'Style', grad: 'hf-g5', img: '/media/pre-paparazzi.jpg', badge: '▶ Preset' },
    { label: 'Bullet Time', sub: 'Camera', grad: 'hf-g3', img: '/media/hero-bullet.jpg', badge: '▶ Preset' },
    { label: 'Neon Tokyo', sub: 'Style', grad: 'hf-g2', img: '/media/hero-neon.jpg', badge: '▶ Preset' },
    { label: 'Crash Zoom', sub: 'Camera', grad: 'hf-g9', img: '/media/pre-crashzoom.jpg', badge: '▶ Preset' },
    { label: 'FPV Drone', sub: 'Motion', grad: 'hf-g4', img: '/media/hero-aerial.jpg', badge: '▶ Preset' },
    { label: 'Earthquake', sub: 'Camera', grad: 'hf-g8', img: '/media/pre-quake.jpg', badge: '▶ Preset' },
    { label: 'Slow Dolly', sub: 'Camera', grad: 'hf-g6', img: '/media/pre-dolly.jpg', badge: '▶ Preset' },
    { label: 'Golden Hour', sub: 'Light', grad: 'hf-g10', img: '/media/pre-golden2.jpg', badge: '▶ Preset' },
    { label: 'Vogue Cover', sub: 'Style', grad: 'hf-g3', img: '/media/hero-vogue.jpg', badge: '▶ Preset' }
];
---

<section id="presets" class="relative scroll-mt-20 border-y border-white/10 bg-white/[0.02] py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="flex flex-wrap items-end justify-between gap-6">
            <div class="max-w-2xl">
                <p class="hf-eyebrow">Viral presets</p>
                <h2 class="mt-3 text-balance text-4xl font-semibold tracking-tight sm:text-5xl">
                    Cinematic effects in one click
                </h2>
                <p class="mt-4 text-lg text-white/60">
                    200+ camera moves, looks and motion templates — tuned by creators, ready to drop onto any prompt.
                </p>
            </div>
            <a href="#" class="hf-btn hf-btn-dark">View all 200+ presets</a>
        </div>

        <div class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6 lg:gap-4">
            {presets.map((p) => <Tile {...p} ratio="aspect-[3/4]" />)}
        </div>
    </div>
</section>
