---
import Wordmark from './Wordmark.astro';

const columns = [
    { title: 'Product', links: ['Image', 'Video', 'Voice', 'Canvas', 'Cinema Studio', 'Plugin'] },
    { title: 'Models', links: ['Seedance', 'Kling', 'Veo 3', 'Sora 2', 'Flux', 'Nano Banana'] },
    { title: 'Resources', links: ['Tutorials', 'Presets', 'Blog', 'Changelog', 'API Docs', 'Status'] },
    { title: 'Company', links: ['About', 'Careers', 'Enterprise', 'Press', 'Contact'] }
];

const socials = [
    { name: 'X', d: 'M18.9 2H22l-7.5 8.6L23 22h-6.8l-5-6.7L5.4 22H2l8.1-9.2L1.7 2h7l4.5 6.1L18.9 2zm-2.4 18h2L8.1 4H6l10.5 16z' },
    { name: 'Instagram', d: 'M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.17.4.37 1 .42 2.2.07 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.05 1.2-.25 1.8-.42 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.17-1 .37-2.2.42-1.3.07-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.05-1.8-.25-2.2-.42-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.17-.4-.37-1-.42-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.05-1.2.25-1.8.42-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.17 1-.37 2.2-.42C8.4 2.2 8.8 2.2 12 2.2zm0 3.2A6.6 6.6 0 1 0 18.6 12 6.6 6.6 0 0 0 12 5.4zm0 10.9A4.3 4.3 0 1 1 16.3 12 4.3 4.3 0 0 1 12 16.3zM18.8 5a1.5 1.5 0 1 0 1.5 1.5A1.5 1.5 0 0 0 18.8 5z' },
    { name: 'YouTube', d: 'M23 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.7-1.7C19.3 5.2 12 5.2 12 5.2s-7.3 0-8.9.4A2.5 2.5 0 0 0 1.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.7 1.7c1.6.4 8.9.4 8.9.4s7.3 0 8.9-.4a2.5 2.5 0 0 0 1.7-1.7C23 15.2 23 12 23 12zM9.8 15.3V8.7l5.7 3.3-5.7 3.3z' },
    { name: 'Discord', d: 'M20.3 4.9A19 19 0 0 0 15.6 3.4l-.2.4a17.6 17.6 0 0 1 4.1 1.3 16.5 16.5 0 0 0-13 0A17.6 17.6 0 0 1 10.6 3.8l-.2-.4A19 19 0 0 0 3.7 4.9 18.9 18.9 0 0 0 .5 17.6a19 19 0 0 0 5.8 2.9l.5-.8a12.4 12.4 0 0 1-2-1l.5-.4a13.3 13.3 0 0 0 11.4 0l.5.4a12.4 12.4 0 0 1-2 1l.5.8a19 19 0 0 0 5.8-2.9 18.9 18.9 0 0 0-3.2-12.7zM8.3 14.9a2.2 2.2 0 0 1 0-4.4 2.2 2.2 0 0 1 0 4.4zm7.4 0a2.2 2.2 0 0 1 0-4.4 2.2 2.2 0 0 1 0 4.4z' }
];
---

<footer class="border-t border-white/10">
    <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
        <div class="grid grid-cols-2 gap-10 lg:grid-cols-6">
            <div class="col-span-2 lg:col-span-2">
                <Wordmark />
                <p class="mt-4 max-w-xs text-sm text-white/50">
                    The AI-native creative suite for image, video and voice.
                </p>
                <div class="mt-5 flex gap-3">
                    {
                        socials.map((s) => (
                            <a
                                href="#"
                                aria-label={s.name}
                                class="grid h-9 w-9 place-items-center rounded-full border border-white/10 text-white/70 no-underline transition hover:border-white/30 hover:text-white"
                            >
                                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d={s.d} /></svg>
                            </a>
                        ))
                    }
                </div>
            </div>

            {
                columns.map((c) => (
                    <div>
                        <h3 class="text-sm font-semibold">{c.title}</h3>
                        <ul class="mt-4 flex flex-col gap-2.5">
                            {c.links.map((l) => (
                                <li>
                                    <a href="#" class="text-sm text-white/55 no-underline transition hover:text-white">
                                        {l}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <div class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs text-white/40">© {new Date().getFullYear()} MEGNUM. All rights reserved.</p>
            <div class="flex gap-5">
                <a href="#" class="text-xs text-white/40 no-underline transition hover:text-white">Terms</a>
                <a href="#" class="text-xs text-white/40 no-underline transition hover:text-white">Privacy</a>
                <a href="#" class="text-xs text-white/40 no-underline transition hover:text-white">Cookies</a>
            </div>
        </div>

        <p class="mt-6 text-[11px] leading-relaxed text-white/30">
            MEGNUM is an independent demo project, not a real commercial product. Model names such as Seedance,
            Kling, Veo and Sora are trademarks of their respective owners and are referenced for illustration only.
            Preview imagery is sourced from <a href="https://unsplash.com" class="underline">Unsplash</a>.
        </p>
    </div>
</footer>
