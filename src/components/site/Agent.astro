---
const steps = [
    { n: '01', t: 'Describe the outcome', d: 'Tell the agent what you want — a 30-second ad, a music video, a product launch.' },
    { n: '02', t: 'It plans the shots', d: 'Storyboards, picks the right model for each beat and writes the prompts for you.' },
    { n: '03', t: 'Generate & refine', d: 'Renders in parallel, then edits, upscales and stitches the final cut on Canvas.' }
];
---

<section id="enterprise" class="relative scroll-mt-20 overflow-hidden border-y border-white/10 bg-white/[0.02] py-20 sm:py-28">
    <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute right-[10%] top-1/2 h-[40vh] w-[40vh] -translate-y-1/2 rounded-full bg-violet-600/20 blur-[120px]"></div>
    </div>

    <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-2">
        <div>
            <p class="hf-eyebrow">MEGNUM Agent</p>
            <h2 class="mt-3 text-balance text-4xl font-semibold tracking-tight sm:text-5xl">
                Your creative <span class="hf-text-gradient">supercomputer</span>
            </h2>
            <p class="mt-4 max-w-xl text-lg text-white/60">
                Hand off the busywork. The agent orchestrates every model on your behalf — planning, generating and
                editing across the whole pipeline while you stay in the director's seat.
            </p>

            <div class="mt-8 flex flex-col gap-4">
                {
                    steps.map((s) => (
                        <div class="flex gap-4">
                            <span class="font-mono text-sm text-white/40">{s.n}</span>
                            <div>
                                <h3 class="font-semibold">{s.t}</h3>
                                <p class="mt-1 text-sm text-white/60">{s.d}</p>
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="mt-8 flex flex-wrap gap-3">
                <a href="#" class="hf-btn hf-btn-gradient">Meet the Agent</a>
                <a href="/enterprise#contact" class="hf-btn hf-btn-outline">Book a demo</a>
            </div>
        </div>

        <!-- stylized agent panel -->
        <div class="hf-card p-5 sm:p-7">
            <div class="flex items-center gap-2 border-b border-white/10 pb-4">
                <span class="h-3 w-3 rounded-full bg-red-400/80"></span>
                <span class="h-3 w-3 rounded-full bg-amber-400/80"></span>
                <span class="h-3 w-3 rounded-full bg-emerald-400/80"></span>
                <span class="ml-2 text-xs text-white/40">agent · session</span>
            </div>
            <div class="space-y-3 py-5 text-sm">
                <p class="ml-auto w-fit max-w-[80%] rounded-2xl rounded-br-sm bg-white/10 px-4 py-2.5">
                    Make me a moody 20s perfume ad, slow motion, golden hour.
                </p>
                <p class="w-fit max-w-[85%] rounded-2xl rounded-bl-sm border border-white/10 bg-white/5 px-4 py-2.5 text-white/80">
                    On it. Planning 4 shots → Seedance for motion, Nano Banana for the bottle, Speak for VO.
                </p>
            </div>
            <div class="grid grid-cols-4 gap-2.5">
                {
                    [
                        { src: '/media/hero-golden.webp', f: 'hf-anim-float' },
                        { src: '/media/hero-drift.webp', f: '' },
                        { src: '/media/prod-canvas.webp', f: 'hf-anim-float-slow' },
                        { src: '/media/hero-storm.webp', f: '' }
                    ].map((t) => (
                        <div class:list={['aspect-square overflow-hidden rounded-xl', t.f]}>
                            <img src={t.src} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
                        </div>
                    ))
                }
            </div>
            <div class="mt-4 flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-white/40">
                <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
                Rendering final cut…
            </div>
        </div>
    </div>
</section>
