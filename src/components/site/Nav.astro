---
import Wordmark from './Wordmark.astro';

const links = [
    { label: 'Products', href: '/#products' },
    { label: 'Presets', href: '/#presets' },
    { label: 'Models', href: '/#models' },
    { label: 'Explore', href: '/explore' },
    { label: 'Pricing', href: '/pricing' },
    { label: 'Enterprise', href: '/enterprise' }
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => !href.includes('#') && (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="sticky top-0 z-50 border-b border-white/10 hf-glass">
    <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8" aria-label="Primary">
        <input type="checkbox" id="hf-nav-toggle" class="peer hidden" />

        <a href="/" class="no-underline" aria-label="MEGNUM home"><Wordmark /></a>

        <ul class="hidden items-center gap-7 lg:flex">
            {
                links.map((l) => (
                    <li>
                        <a
                            href={l.href}
                            aria-current={isActive(l.href) ? 'page' : undefined}
                            class:list={[
                                'text-sm no-underline transition hover:text-white',
                                isActive(l.href) ? 'text-white' : 'text-white/70'
                            ]}
                        >
                            {l.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <div class="hidden items-center gap-3 lg:flex">
            <a href="#" class="text-sm text-white/70 no-underline transition hover:text-white">Sign in</a>
            <a href="/#create" class="hf-btn hf-btn-primary">Start creating</a>
        </div>

        <label for="hf-nav-toggle" class="flex cursor-pointer items-center p-1 lg:hidden" aria-label="Toggle menu">
            <svg class="h-6 w-6 peer-checked:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg class="hidden h-6 w-6 peer-checked:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M6 6l12 12M18 6l-12 12"></path>
            </svg>
        </label>

        <div
            id="hf-mobile-menu"
            class="absolute inset-x-0 top-16 hidden flex-col gap-1 border-b border-white/10 px-5 pb-6 pt-2 hf-glass peer-checked:flex lg:hidden"
        >
            {
                links.map((l) => (
                    <a
                        href={l.href}
                        aria-current={isActive(l.href) ? 'page' : undefined}
                        class="rounded-lg px-3 py-2.5 text-base text-white/80 no-underline transition hover:bg-white/5"
                    >
                        {l.label}
                    </a>
                ))
            }
            <div class="mt-3 flex flex-col gap-2">
                <a href="#" class="hf-btn hf-btn-outline">Sign in</a>
                <a href="/#create" class="hf-btn hf-btn-primary">Start creating</a>
            </div>
        </div>
    </nav>
</header>

<script>
    // Close the mobile menu after a link is tapped.
    const toggle = document.getElementById('hf-nav-toggle') as HTMLInputElement | null;
    document.getElementById('hf-mobile-menu')?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a') && toggle) toggle.checked = false;
    });
</script>
