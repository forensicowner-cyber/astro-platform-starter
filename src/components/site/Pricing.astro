---
const tiers = [
    {
        name: 'Free',
        price: '$0',
        cadence: '/mo',
        blurb: 'For trying things out.',
        cta: 'Start free',
        style: 'outline',
        features: ['50 credits / month', 'Standard models', 'Community presets', 'Watermarked exports']
    },
    {
        name: 'Pro',
        price: '$17',
        cadence: '/mo',
        blurb: 'For serious creators.',
        cta: 'Go Pro',
        style: 'primary',
        featured: true,
        features: ['Unlimited standard generations', 'All 200+ presets', 'HD exports, no watermark', 'Priority queue', 'Commercial license']
    },
    {
        name: 'Ultimate',
        price: '$49',
        cadence: '/mo',
        blurb: 'For studios & teams.',
        cta: 'Go Ultimate',
        style: 'outline',
        features: ['Everything in Pro', '4K exports + upscaling', 'Early-access models', 'MEGNUM Agent', 'API access & team seats']
    }
];
---

<section id="pricing" class="mx-auto max-w-7xl scroll-mt-20 px-5 py-20 sm:px-8 sm:py-28">
    <div class="mx-auto max-w-2xl text-center">
        <p class="hf-eyebrow">Pricing</p>
        <h2 class="mt-3 text-balance text-4xl font-semibold tracking-tight sm:text-5xl">Create more, pay less</h2>
        <p class="mt-4 text-lg text-white/60">
            Every model and tool on one plan. <span class="hf-chip ml-1 align-middle">Save 20% annually</span>
        </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-4 lg:grid-cols-3">
        {
            tiers.map((t) => (
                <div
                    class:list={[
                        'hf-card flex flex-col p-7',
                        t.featured && 'ring-2 ring-purple-500/60'
                    ]}
                >
                    {t.featured && (
                        <span class="absolute right-5 top-5 rounded-full bg-gradient-to-r from-violet-400 to-purple-500 px-2.5 py-1 text-[11px] font-semibold text-white">
                            Most popular
                        </span>
                    )}
                    <h3 class="text-lg font-semibold">{t.name}</h3>
                    <p class="mt-1 text-sm text-white/50">{t.blurb}</p>
                    <p class="mt-5 flex items-baseline gap-1">
                        <span class="text-4xl font-semibold tracking-tight">{t.price}</span>
                        <span class="text-sm text-white/50">{t.cadence}</span>
                    </p>
                    <a
                        href="#"
                        class:list={['hf-btn mt-5 w-full', t.style === 'primary' ? 'hf-btn-primary' : 'hf-btn-outline']}
                    >
                        {t.cta}
                    </a>
                    <ul class="mt-6 flex flex-col gap-3 text-sm">
                        {t.features.map((f) => (
                            <li class="flex items-start gap-2.5 text-white/70">
                                <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-purple-400" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 6L9 17l-5-5" />
                                </svg>
                                {f}
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>
    <p class="mt-6 text-center text-xs text-white/30">Prices shown are illustrative for this design demo.</p>
</section>
