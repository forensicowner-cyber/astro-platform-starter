---
interface Props {
    items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10">
    {
        items.map((it) => (
            <details class="group">
                <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 text-base font-medium [&::-webkit-details-marker]:hidden">
                    {it.q}
                    <svg class="h-5 w-5 shrink-0 text-white/40 transition group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                </summary>
                <p class="px-5 pb-5 text-sm leading-relaxed text-white/60">{it.a}</p>
            </details>
        ))
    }
</div>
