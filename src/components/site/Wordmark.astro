---
interface Props {
    class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="1.25" y="1.25" width="21.5" height="21.5" rx="6" fill="url(#mg-tile)"></rect>
        <path d="M6 17.5V7.4l6 5.3 6-5.3v10.1" stroke="#ffffff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"></path>
        <defs>
            <linearGradient id="mg-tile" x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse">
                <stop stop-color="#c084fc"></stop>
                <stop offset="0.5" stop-color="#a855f7"></stop>
                <stop offset="1" stop-color="#6d28d9"></stop>
            </linearGradient>
        </defs>
    </svg>
    <span class="text-[1.15rem] font-semibold tracking-[0.12em]">MEGNUM</span>
</span>
