---
const columns = [
    {
        kind: 'Image',
        grad: 'hf-g5',
        blurb: 'Photoreal stills, product shots and character art.',
        models: ['Nano Banana Pro', 'Seedream 4', 'Flux 1.1', 'Ideogram 3', 'Recraft v3']
    },
    {
        kind: 'Video',
        grad: 'hf-g2',
        blurb: 'Cinematic motion with real camera and character control.',
        models: ['Seedance 2.0', 'Kling 2.5', 'Veo 3', 'Sora 2', 'Hailuo', 'Wan 2.5']
    },
    {
        kind: 'Audio',
        grad: 'hf-g3',
        blurb: 'Voices, lipsync and soundtracks that match the cut.',
        models: ['Speak v3', 'Lipsync Studio', 'Voice Clone', 'Soundtrack']
    }
];
---

<section id="models" class="mx-auto max-w-7xl scroll-mt-20 px-5 py-20 sm:px-8 sm:py-28">
    <div class="max-w-2xl">
        <p class="hf-eyebrow">Models</p>
        <h2 class="mt-3 text-balance text-4xl font-semibold tracking-tight sm:text-5xl">The frontier, all in one place</h2>
        <p class="mt-4 text-lg text-white/60">
            No more juggling subscriptions. Switch between the best image, video and audio models mid-project and keep
            your style consistent.
        </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
            columns.map((c) => (
                <div class="hf-card flex flex-col p-6">
                    <div class="flex items-center gap-3">
                        <span class:list={['grid h-10 w-10 place-items-center rounded-xl text-sm font-bold text-black', c.grad]}>
                            {c.kind[0]}
                        </span>
                        <h3 class="text-xl font-semibold">{c.kind}</h3>
                    </div>
                    <p class="mt-3 text-sm text-white/60">{c.blurb}</p>
                    <ul class="mt-5 flex flex-col gap-2">
                        {c.models.map((m) => (
                            <li class="flex items-center justify-between rounded-xl border border-white/5 bg-white/5 px-4 py-2.5 text-sm">
                                <span class="font-medium">{m}</span>
                                <span class="text-xs text-white/40">Ready</span>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>
</section>
