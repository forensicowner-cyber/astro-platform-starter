---
const year = new Date().getFullYear();
const cols = [
    { title: 'Collections', links: ['Rings', 'Necklaces', 'Earrings', 'Bangles', 'Bridal Sets', 'Pendants'] },
    { title: 'Maison', links: ['Our Heritage', 'Craftsmanship', 'Hallmarking', 'Live Rates', 'Boutiques'] },
    { title: 'Care', links: ['Lifetime Service', 'Exchange Policy', 'Certification', 'Shipping', 'Contact Us'] }
];
---

<footer class="border-t border-gold/15 bg-ink-soft pt-16">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="grid gap-12 pb-12 lg:grid-cols-5">
            <div class="lg:col-span-2">
                <div class="flex flex-col leading-none">
                    <span class="font-serif text-3xl gold-text">Pipadeshwar</span>
                    <span class="text-[0.65rem] uppercase tracking-[0.5em] text-cream-soft/60">Jewellers</span>
                </div>
                <p class="mt-5 max-w-sm text-sm leading-relaxed text-cream-soft/60">
                    Crafting timeless gold, diamond and silver jewellery since 1972. Where heritage
                    artistry meets transparent, rate-honest pricing.
                </p>
                <div class="mt-6 flex gap-3">
                    {
                        ['Instagram', 'Facebook', 'Pinterest', 'YouTube'].map((s) => (
                            <a href="#" aria-label={s} class="grid h-10 w-10 place-items-center border border-white/10 text-xs uppercase tracking-wide text-cream-soft/70 no-underline transition hover:border-gold hover:text-gold">
                                {s[0]}
                            </a>
                        ))
                    }
                </div>
            </div>

            {
                cols.map((col) => (
                    <div>
                        <h4 class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-gold">{col.title}</h4>
                        <ul class="space-y-2.5">
                            {col.links.map((l) => (
                                <li>
                                    <a href="#" class="text-sm text-cream-soft/65 no-underline transition hover:text-gold">
                                        {l}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <div class="hairline"></div>
        <div class="flex flex-col items-center justify-between gap-3 py-6 text-xs text-cream-soft/45 sm:flex-row">
            <p>© {year} Pipadeshwar Jewellers. All rights reserved. BIS Hallmarked.</p>
            <p>Crafted with devotion in India · Live rates powered by international spot markets.</p>
        </div>
    </div>
</footer>
