---
const links = [
    { href: '/#collections', label: 'Collections' },
    { href: '/shop', label: 'Shop' },
    { href: '/#rates', label: 'Live Rates' },
    { href: '/#craft', label: 'Craftsmanship' },
    { href: '/#contact', label: 'Contact' }
];
---

<!-- Live rate ticker -->
<div class="border-b border-gold/15 bg-ink-soft text-xs">
    <div class="flex items-center">
        <span class="hidden shrink-0 px-4 py-2 font-medium uppercase tracking-[0.25em] text-ink bg-gold sm:block">
            Live Rates
        </span>
        <div class="relative flex-1 overflow-hidden py-2">
            <div id="rate-marquee" class="marquee-track flex w-max gap-12 whitespace-nowrap px-6 text-cream-soft">
                <span class="opacity-60">Fetching live Indian gold &amp; silver rates…</span>
            </div>
        </div>
    </div>
</div>

<header id="site-header" class="sticky top-0 z-50 border-b border-white/5 bg-ink/80 backdrop-blur-xl transition-colors duration-300">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
        <a href="/" class="group flex flex-col leading-none no-underline">
            <span class="font-serif text-2xl tracking-wide gold-text">Pipadeshwar</span>
            <span class="text-[0.6rem] uppercase tracking-[0.5em] text-cream-soft/70">Jewellers</span>
        </a>

        <nav class="hidden items-center gap-9 lg:flex">
            {
                links.map((l) => (
                    <a
                        href={l.href}
                        class="relative text-xs font-medium uppercase tracking-[0.2em] text-cream-soft no-underline after:absolute after:-bottom-1.5 after:left-0 after:h-px after:w-0 after:bg-gold after:transition-all after:duration-300 hover:text-gold hover:after:w-full"
                    >
                        {l.label}
                    </a>
                ))
            }
        </nav>

        <div class="flex items-center gap-2">
            <button
                id="cart-open"
                class="group relative flex items-center gap-2 border border-gold/40 px-4 py-2.5 text-xs font-medium uppercase tracking-[0.2em] text-cream transition hover:border-gold hover:bg-gold/10"
            >
                <svg class="h-4 w-4 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.3 4.6A1 1 0 0 0 5.6 19H19" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="9" cy="21" r="1" /><circle cx="18" cy="21" r="1" />
                </svg>
                <span class="hidden sm:inline">Cart</span>
                <span id="cart-count" class="grid h-5 min-w-5 place-items-center rounded-full bg-gold px-1 text-[0.65rem] font-semibold text-ink">0</span>
            </button>

            <button id="menu-open" class="grid h-10 w-10 place-items-center text-cream lg:hidden" aria-label="Open menu">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden border-t border-white/5 bg-ink lg:hidden">
        <nav class="flex flex-col px-5 py-4">
            {
                links.map((l) => (
                    <a href={l.href} class="border-b border-white/5 py-3 text-sm uppercase tracking-[0.2em] text-cream-soft no-underline last:border-0 hover:text-gold">
                        {l.label}
                    </a>
                ))
            }
        </nav>
    </div>
</header>

<script is:inline>
    (function () {
        // Mobile menu
        const menuBtn = document.getElementById('menu-open');
        const menu = document.getElementById('mobile-menu');
        menuBtn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
        menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.add('hidden')));

        // Header shadow on scroll
        const header = document.getElementById('site-header');
        window.addEventListener(
            'scroll',
            () => {
                if (window.scrollY > 20) header?.classList.add('shadow-2xl', 'shadow-black/40');
                else header?.classList.remove('shadow-2xl', 'shadow-black/40');
            },
            { passive: true }
        );

        // Live rates ticker
        const fmt = (n) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(n);
        fetch('/api/rates')
            .then((r) => r.json())
            .then((d) => {
                const marquee = document.getElementById('rate-marquee');
                if (!marquee) return;
                const dot = '<span class="text-gold">◆</span>';
                const item = (label, value) =>
                    `<span>${label} <strong class="text-gold font-medium">${fmt(value)}</strong></span>`;
                const set = [
                    item('Gold 24K / 10g', d.gold.per10g_24k),
                    item('Gold 22K / 10g', d.gold.per10g_22k),
                    item('Silver / kg', d.silver.per1kg),
                    item('Silver / 10g', d.silver.per10g),
                    `<span class="opacity-60">USD/INR ${d.usdInr}</span>`,
                    `<span class="opacity-60">${d.live ? 'Live market' : 'Indicative'}</span>`
                ].join(` ${dot} `);
                // Duplicate the content so the marquee loops seamlessly.
                marquee.innerHTML = `<span class="flex gap-12">${set}</span><span class="flex gap-12">${set}</span>`;

                // Broadcast for any other listeners (live rates section).
                window.__pj_rates = d;
                document.dispatchEvent(new CustomEvent('pj:rates', { detail: d }));
            })
            .catch(() => {});
    })();
</script>
