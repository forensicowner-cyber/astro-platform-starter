---
import { categories } from '../../data/products';
---

<section id="collections" class="bg-ink py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="mb-14 flex flex-col items-end justify-between gap-6 sm:flex-row">
            <div>
                <p class="eyebrow reveal mb-5">Curated For You</p>
                <h2 class="reveal max-w-xl" style="--reveal-delay:100ms">Explore Our Collections</h2>
            </div>
            <a href="/shop" class="reveal btn btn-outline" style="--reveal-delay:200ms">View All Pieces</a>
        </div>

        <div class="grid auto-rows-[16rem] grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
            {
                categories.map((cat, i) => (
                    <a
                        href={`/shop?category=${cat.id}`}
                        class:list={[
                            'card-luxe reveal-scale group block no-underline',
                            i === 0 && 'lg:col-span-2 lg:row-span-2',
                            i === 3 && 'lg:row-span-2'
                        ]}
                        style={`--reveal-delay:${i * 90}ms`}
                    >
                        <div class="relative h-full w-full overflow-hidden">
                            <img
                                src={cat.image}
                                alt={cat.name}
                                loading="lazy"
                                class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-110"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent" />
                            <div class="absolute inset-x-0 bottom-0 p-6">
                                <div class="h-px w-8 bg-gold transition-all duration-500 group-hover:w-16" />
                                <h3 class="mt-3 font-serif text-2xl text-cream">{cat.name}</h3>
                                <span class="mt-1 inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-gold opacity-0 transition-all duration-500 group-hover:opacity-100">
                                    Discover →
                                </span>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</section>
