---
import SalesLayout from '../layouts/SalesLayout.astro';
import Nav from '../components/sell/Nav.astro';
import SellFooter from '../components/sell/SellFooter.astro';
import Reveal from '../components/sell/Reveal.astro';

const planParam = Astro.url.searchParams.get('plan') ?? 'growth';

const plans: Record<string, { name: string; price: string; period: string; trial: string }> = {
    starter: { name: 'Starter', price: '₹0',     period: 'forever',   trial: 'Free forever — no card required' },
    growth:  { name: 'Growth',  price: '₹999',   period: 'per month', trial: '14-day free trial — billed after trial' },
    scale:   { name: 'Scale',   price: '₹2,999', period: 'per month', trial: '14-day free trial — billed after trial' }
};
const plan = plans[planParam] ?? plans.growth;
---

<SalesLayout title={`Checkout — ${plan.name} — NovaPro`}>
    <Nav />

    <section class="sell-section pt-12">
        <div class="sell-container max-w-5xl">
            <Reveal>
                <a href="/sell#pricing" class="text-sm text-[color:var(--color-sell-muted)] no-underline hover:text-white inline-flex items-center gap-2">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                    Back to plans
                </a>
            </Reveal>

            <Reveal delay={1}>
                <h1 class="mt-4 text-3xl sm:text-5xl font-bold text-white">
                    Almost there. <span class="sell-gradient-text">Let's get you set up.</span>
                </h1>
                <p class="mt-3 text-[color:var(--color-sell-muted)]">{plan.trial}</p>
            </Reveal>

            <div class="grid lg:grid-cols-[1fr_0.8fr] gap-8 mt-10">
                <!-- Form -->
                <Reveal delay={2}>
                    <form class="sell-card p-7 sm:p-9 space-y-6" id="checkoutForm">
                        <span class="sell-card-glow"></span>

                        <div>
                            <h2 class="text-lg font-semibold text-white mb-4">Your details</h2>
                            <div class="grid sm:grid-cols-2 gap-4">
                                <label class="sell-field">
                                    <span>Full name</span>
                                    <input type="text" name="name" required placeholder="Priya Sharma" />
                                </label>
                                <label class="sell-field">
                                    <span>Email</span>
                                    <input type="email" name="email" required placeholder="you@company.com" />
                                </label>
                                <label class="sell-field sm:col-span-2">
                                    <span>Phone (for order updates)</span>
                                    <input type="tel" name="phone" required placeholder="+91 98xxxxxx00" />
                                </label>
                            </div>
                        </div>

                        <div>
                            <h2 class="text-lg font-semibold text-white mb-4">Payment method</h2>
                            <div class="grid sm:grid-cols-2 gap-3">
                                <label class="sell-pay-option">
                                    <input type="radio" name="pay" value="upi" checked />
                                    <div>
                                        <p class="font-medium text-white">UPI</p>
                                        <p class="text-xs text-[color:var(--color-sell-muted)]">GPay, PhonePe, Paytm</p>
                                    </div>
                                </label>
                                <label class="sell-pay-option">
                                    <input type="radio" name="pay" value="card" />
                                    <div>
                                        <p class="font-medium text-white">Card</p>
                                        <p class="text-xs text-[color:var(--color-sell-muted)]">Visa, Mastercard, Rupay</p>
                                    </div>
                                </label>
                                <label class="sell-pay-option">
                                    <input type="radio" name="pay" value="netbanking" />
                                    <div>
                                        <p class="font-medium text-white">Net Banking</p>
                                        <p class="text-xs text-[color:var(--color-sell-muted)]">All major banks</p>
                                    </div>
                                </label>
                                <label class="sell-pay-option">
                                    <input type="radio" name="pay" value="wallet" />
                                    <div>
                                        <p class="font-medium text-white">Wallet</p>
                                        <p class="text-xs text-[color:var(--color-sell-muted)]">Paytm, Mobikwik, Amazon Pay</p>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <label class="flex items-start gap-2 text-sm text-[color:var(--color-sell-muted)]">
                            <input type="checkbox" required class="mt-1" />
                            <span>I agree to the <a href="/terms" class="text-white">Terms</a> and <a href="/privacy" class="text-white">Privacy Policy</a>.</span>
                        </label>

                        <button type="submit" class="sell-btn w-full sell-btn-lg">
                            Confirm & start trial
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                        </button>
                        <p class="text-xs text-center text-[color:var(--color-sell-muted)]">
                            🔒 Secured by 256-bit SSL. Your data never touches our servers.
                        </p>
                    </form>
                </Reveal>

                <!-- Order summary -->
                <Reveal delay={3}>
                    <aside class="sell-card p-7 h-fit sticky top-24">
                        <span class="sell-card-glow is-active"></span>
                        <h2 class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-sell-muted)]">
                            Order summary
                        </h2>
                        <div class="mt-5 flex items-center justify-between">
                            <div>
                                <p class="text-white font-semibold">NovaPro {plan.name}</p>
                                <p class="text-xs text-[color:var(--color-sell-muted)]">{plan.period}</p>
                            </div>
                            <p class="text-xl font-bold text-white">{plan.price}</p>
                        </div>

                        <div class="mt-5 pt-5 border-t border-white/5 space-y-2 text-sm">
                            <div class="flex justify-between text-[color:var(--color-sell-muted)]">
                                <span>Subtotal</span><span>{plan.price}</span>
                            </div>
                            <div class="flex justify-between text-emerald-400">
                                <span>Trial discount</span><span>− {plan.price}</span>
                            </div>
                            <div class="flex justify-between text-white font-semibold pt-3 border-t border-white/5">
                                <span>Due today</span><span>₹0</span>
                            </div>
                        </div>

                        <div class="mt-6 p-4 rounded-lg bg-[color:var(--color-sell-accent)]/10 border border-[color:var(--color-sell-accent)]/30">
                            <p class="text-xs text-white/90 leading-relaxed">
                                ✨ <strong>14-day free trial.</strong> Cancel anytime in one click. We'll email you 3 days before your trial ends.
                            </p>
                        </div>
                    </aside>
                </Reveal>
            </div>
        </div>
    </section>

    <SellFooter />

    <script is:inline>
        (() => {
            const form = document.getElementById('checkoutForm');
            if (!form) return;
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                window.location.href = '/thank-you';
            });
        })();
    </script>
</SalesLayout>

<style>
    .sell-field {
        display: block;
    }
    .sell-field > span {
        display: block;
        font-size: 0.78rem;
        color: var(--color-sell-muted);
        margin-bottom: 0.4rem;
    }
    .sell-field input {
        width: 100%;
        padding: 0.75rem 0.95rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--color-sell-border);
        border-radius: 0.5rem;
        color: white;
        font-size: 0.95rem;
        transition: border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .sell-field input:focus {
        outline: none;
        border-color: var(--color-sell-accent);
        box-shadow: 0 0 0 3px rgba(124, 92, 255, 0.18);
    }

    .sell-pay-option {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-sell-border);
        border-radius: 0.6rem;
        cursor: pointer;
        transition: border-color 0.25s ease, background 0.25s ease;
    }
    .sell-pay-option:has(input:checked) {
        border-color: var(--color-sell-accent);
        background: rgba(124, 92, 255, 0.08);
    }
    .sell-pay-option input {
        accent-color: var(--color-sell-accent);
    }
</style>
