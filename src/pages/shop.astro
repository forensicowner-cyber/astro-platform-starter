---
import Layout from '../layouts/Layout.astro';
import Header from '../components/jewellery/Header.astro';
import Footer from '../components/jewellery/Footer.astro';
import CartDrawer from '../components/jewellery/CartDrawer.astro';
import ProductCard from '../components/jewellery/ProductCard.astro';
import { products, categories } from '../data/products';
---

<Layout title="Shop — Pipadeshwar Jewellers">
    <Header />
    <main>
        <!-- Page header -->
        <section class="relative overflow-hidden border-b border-white/5 bg-ink-soft py-20 sm:py-28">
            <div class="absolute inset-0 -z-10 opacity-[0.04]" style="background-image:radial-gradient(circle at 1px 1px, #c9a24b 1px, transparent 0); background-size: 32px 32px;"></div>
            <div class="mx-auto max-w-7xl px-5 text-center sm:px-8">
                <p class="eyebrow reveal mb-5 justify-center">The Full Catalogue</p>
                <h1 class="reveal" style="--reveal-delay:100ms">The Boutique</h1>
                <p class="reveal mx-auto mt-5 max-w-2xl text-cream-soft/70" style="--reveal-delay:200ms">
                    Explore every Pipadeshwar creation. Filter by collection to find your perfect piece.
                </p>
            </div>
        </section>

        <section class="bg-ink py-14 sm:py-20">
            <div class="mx-auto max-w-7xl px-5 sm:px-8">
                <!-- Filters -->
                <div id="filters" class="reveal mb-12 flex flex-wrap justify-center gap-3">
                    <button data-filter="all" class="filter-btn is-active border border-gold bg-gold px-5 py-2.5 text-xs font-medium uppercase tracking-[0.2em] text-ink transition">
                        All
                    </button>
                    {
                        categories.map((c) => (
                            <button data-filter={c.id} class="filter-btn border border-white/15 px-5 py-2.5 text-xs font-medium uppercase tracking-[0.2em] text-cream-soft transition hover:border-gold hover:text-gold">
                                {c.name}
                            </button>
                        ))
                    }
                </div>

                <!-- Grid -->
                <div id="product-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
                    {
                        products.map((p, i) => (
                            <div class="product-item" data-category={p.category}>
                                <ProductCard product={p} index={i} />
                            </div>
                        ))
                    }
                </div>
                <p id="no-results" class="mt-16 hidden text-center text-cream-soft/50">No pieces in this collection yet — check back soon.</p>
            </div>
        </section>
    </main>
    <Footer />
    <CartDrawer />
</Layout>

<script is:inline>
    (function () {
        const buttons = document.querySelectorAll('.filter-btn');
        const items = document.querySelectorAll('.product-item');
        const noResults = document.getElementById('no-results');

        function apply(filter) {
            let shown = 0;
            items.forEach((it) => {
                const match = filter === 'all' || it.getAttribute('data-category') === filter;
                it.style.display = match ? '' : 'none';
                if (match) shown++;
            });
            noResults.classList.toggle('hidden', shown > 0);

            buttons.forEach((b) => {
                const active = b.getAttribute('data-filter') === filter;
                b.classList.toggle('is-active', active);
                b.classList.toggle('bg-gold', active);
                b.classList.toggle('text-ink', active);
                b.classList.toggle('border-gold', active);
                b.classList.toggle('text-cream-soft', !active);
                b.classList.toggle('border-white/15', !active);
            });
        }

        buttons.forEach((b) => b.addEventListener('click', () => apply(b.getAttribute('data-filter'))));

        // Honour ?category= from the URL (links from the Collections section).
        const params = new URLSearchParams(location.search);
        const initial = params.get('category');
        if (initial) apply(initial);
    })();
</script>
