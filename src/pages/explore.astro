---
import SiteLayout from '../layouts/SiteLayout.astro';

const cats = ['All', 'Video', 'Image', 'Portrait', 'Aerial', 'Abstract'];

const gallery = [
    { src: '/media/hero-drift.webp', cat: 'Video', prompt: 'midnight drift, neon trails', model: 'Seedance 2.0' },
    { src: '/media/hero-neon.webp', cat: 'Image', prompt: 'neon tokyo alley after rain', model: 'Nano Banana' },
    { src: '/media/hero-vogue.webp', cat: 'Portrait', prompt: 'editorial vogue cover', model: 'Seedream 4' },
    { src: '/media/hero-space.webp', cat: 'Video', prompt: 'deep space nebula flythrough', model: 'Veo 3' },
    { src: '/media/hero-aerial.webp', cat: 'Aerial', prompt: 'drone over snow peaks', model: 'Kling 2.5' },
    { src: '/media/hero-storm.webp', cat: 'Video', prompt: 'supercell storm timelapse', model: 'Sora 2' },
    { src: '/media/hero-golden.webp', cat: 'Portrait', prompt: 'golden hour close-up', model: 'Flux 1.1' },
    { src: '/media/hero-bullet.webp', cat: 'Video', prompt: 'bullet-time spin', model: 'Seedance 2.0' },
    { src: '/media/pre-kungfu.webp', cat: 'Video', prompt: 'kung-fu impact frame', model: 'Kling 2.5' },
    { src: '/media/pre-paparazzi.webp', cat: 'Portrait', prompt: '2000s paparazzi flash', model: 'Seedream 4' },
    { src: '/media/pre-crashzoom.webp', cat: 'Video', prompt: 'crash zoom reveal', model: 'Veo 3' },
    { src: '/media/pre-quake.webp', cat: 'Video', prompt: 'earthquake street shake', model: 'Sora 2' },
    { src: '/media/pre-dolly.webp', cat: 'Aerial', prompt: 'slow dolly over valley', model: 'Kling 2.5' },
    { src: '/media/pre-golden2.webp', cat: 'Portrait', prompt: 'warm sunset portrait', model: 'Flux 1.1' },
    { src: '/media/prod-canvas.webp', cat: 'Abstract', prompt: 'liquid chrome bloom', model: 'Nano Banana' },
    { src: '/media/prod-cinema.webp', cat: 'Video', prompt: 'anamorphic film still', model: 'Seedance 2.0' },
    { src: '/media/prod-plugin.webp', cat: 'Abstract', prompt: 'ink diffusion study', model: 'Flux 1.1' },
    { src: '/media/prod-games.webp', cat: 'Image', prompt: 'stylized game key art', model: 'Nano Banana' },
    { src: '/media/prod-speak.webp', cat: 'Image', prompt: 'studio mic macro', model: 'Seedream 4' },
    { src: '/media/model-image.webp', cat: 'Portrait', prompt: 'soft beauty portrait', model: 'Flux 1.1' },
    { src: '/media/model-video.webp', cat: 'Video', prompt: 'cinematic chase frame', model: 'Kling 2.5' },
    { src: '/media/model-audio.webp', cat: 'Abstract', prompt: 'waveform sculpture', model: 'Nano Banana' }
];
---

<SiteLayout
    title="Explore — Higgsfield"
    description="A gallery of community creations across every model — video, image, portrait, aerial and abstract. Remix any prompt in one click."
>
    <section class="mx-auto max-w-7xl px-5 pb-10 pt-20 sm:px-8 sm:pt-24">
        <div class="max-w-2xl">
            <p class="hf-eyebrow">Explore</p>
            <h1 class="mt-3 text-balance text-5xl font-semibold tracking-tight sm:text-6xl">Made with Higgsfield</h1>
            <p class="mt-4 text-lg text-white/60">
                A living gallery from the community. Hover any frame to see the prompt and model — then remix it your way.
            </p>
        </div>

        <div id="hf-filters" class="mt-8 flex flex-wrap gap-2" role="tablist" aria-label="Filter gallery">
            {
                cats.map((c, i) => (
                    <button
                        type="button"
                        data-cat={c}
                        aria-pressed={i === 0 ? 'true' : 'false'}
                        class:list={[
                            'rounded-full border px-4 py-1.5 text-sm font-medium transition',
                            i === 0 ? 'border-white bg-white text-black' : 'border-white/15 bg-white/5 text-white/70 hover:text-white'
                        ]}
                    >
                        {c}
                    </button>
                ))
            }
        </div>

        <div id="hf-gallery" class="mt-8 columns-2 gap-4 md:columns-3 lg:columns-4 [&>*]:mb-4">
            {
                gallery.map((g, i) => (
                    <figure data-cat={g.cat} class="group relative break-inside-avoid overflow-hidden rounded-2xl border border-white/10">
                        <img src={g.src} alt={g.prompt} loading={i < 6 ? 'eager' : 'lazy'} decoding="async" class="w-full transition duration-500 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 transition group-hover:opacity-100" />
                        <figcaption class="absolute inset-x-0 bottom-0 translate-y-2 p-4 opacity-0 transition group-hover:translate-y-0 group-hover:opacity-100">
                            <p class="text-sm font-medium">{g.prompt}</p>
                            <p class="mt-0.5 text-xs text-white/60">{g.model} · {g.cat}</p>
                            <span class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-fuchsia-300">Remix <span aria-hidden="true">→</span></span>
                        </figcaption>
                    </figure>
                ))
            }
        </div>
        <p id="hf-empty" class="hidden py-16 text-center text-white/40">No results in this category yet.</p>
    </section>
</SiteLayout>

<script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('#hf-filters [data-cat]'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('#hf-gallery [data-cat]'));
    const empty = document.getElementById('hf-empty');

    function setActive(btn: HTMLButtonElement) {
        buttons.forEach((b) => {
            const on = b === btn;
            b.setAttribute('aria-pressed', String(on));
            b.classList.toggle('bg-white', on);
            b.classList.toggle('text-black', on);
            b.classList.toggle('border-white', on);
            b.classList.toggle('bg-white/5', !on);
            b.classList.toggle('text-white/70', !on);
            b.classList.toggle('border-white/15', !on);
        });
    }

    buttons.forEach((btn) =>
        btn.addEventListener('click', () => {
            const cat = btn.dataset.cat || 'All';
            setActive(btn);
            let shown = 0;
            items.forEach((el) => {
                const match = cat === 'All' || el.dataset.cat === cat;
                el.style.display = match ? '' : 'none';
                if (match) shown += 1;
            });
            empty?.classList.toggle('hidden', shown > 0);
        })
    );
</script>
