---
import SiteLayout from '../layouts/SiteLayout.astro';
import Faq from '../components/site/Faq.astro';

const features = [
    { t: 'SSO & SAML', d: 'Okta, Azure AD and Google Workspace with SCIM provisioning and enforced 2FA.', icon: 'M12 1l9 4v6c0 5-3.8 9.4-9 11-5.2-1.6-9-6-9-11V5l9-4z' },
    { t: 'Private models', d: 'Dedicated, isolated model capacity so your prompts and assets never touch shared infra.', icon: 'M4 7h16M4 12h16M4 17h10' },
    { t: 'Custom training', d: 'Fine-tune brand styles, characters and products on your own reference library.', icon: 'M12 3v18M3 12h18' },
    { t: 'API & webhooks', d: 'Generate, edit and orchestrate programmatically and wire results into your stack.', icon: 'M8 6l-6 6 6 6M16 6l6 6-6 6' },
    { t: 'Governance', d: 'Org-wide usage limits, content controls, audit logs and granular role permissions.', icon: 'M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z' },
    { t: 'Dedicated support', d: 'A named solutions engineer, onboarding, and a 99.9% uptime SLA in writing.', icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z' }
];

const stats = [
    { v: '99.9%', l: 'Uptime SLA' },
    { v: 'SOC 2', l: 'Type II' },
    { v: '<30m', l: 'Support response' },
    { v: '500M+', l: 'Assets generated' }
];

const compliance = ['SOC 2 Type II', 'GDPR', 'ISO 27001', 'CSA STAR', 'SSO / SAML', 'Data residency'];

const faqs = [
    { q: 'How is our data handled?', a: 'Enterprise prompts and assets run on isolated capacity, are never used to train shared models, and can be auto-deleted on a schedule you define.' },
    { q: 'Can we deploy in our own region?', a: 'Yes — we support regional data residency in the US and EU, with more regions available on request.' },
    { q: 'Do you support volume pricing?', a: 'Enterprise plans are seat- and usage-based with committed-use discounts. Tell us your scale and we will tailor it.' }
];
---

<SiteLayout
    title="Enterprise — Higgsfield"
    description="Generative media at company scale: SSO, private models, custom training, API access, governance and a 99.9% uptime SLA."
>
    <!-- hero -->
    <section class="relative overflow-hidden">
        <div class="pointer-events-none absolute inset-0 -z-10">
            <div class="absolute left-1/2 top-[-10%] h-[44vh] w-[44vh] -translate-x-1/2 rounded-full bg-violet-600/25 blur-[130px] hf-anim-aurora"></div>
        </div>
        <div class="mx-auto max-w-7xl px-5 pb-12 pt-20 sm:px-8 sm:pt-28">
            <div class="max-w-3xl">
                <span class="hf-chip">For teams &amp; studios</span>
                <h1 class="mt-5 text-balance text-5xl font-semibold leading-[1.03] tracking-tight sm:text-7xl">
                    Generative media at <span class="hf-text-gradient">company scale</span>
                </h1>
                <p class="mt-5 max-w-xl text-lg text-white/60">
                    Give every team the full Higgsfield suite with the security, control and support that enterprises
                    require — on dedicated, private infrastructure.
                </p>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a href="#contact" class="hf-btn hf-btn-gradient hf-btn-lg">Talk to sales</a>
                    <a href="#contact" class="hf-btn hf-btn-outline hf-btn-lg">Book a demo</a>
                </div>
            </div>

            <!-- logo cloud -->
            <div class="mt-16 border-t border-white/10 pt-8">
                <p class="mb-5 hf-eyebrow">Trusted by modern creative teams</p>
                <div class="flex flex-wrap items-center gap-x-10 gap-y-4 text-lg font-semibold text-white/35">
                    <span>Northwind</span><span>Lumen</span><span>Vertex</span><span>Atlas Studios</span>
                    <span>Monohaus</span><span>Polaris</span><span>Foundry</span>
                </div>
            </div>
        </div>
    </section>

    <!-- features -->
    <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
                features.map((f) => (
                    <div class="hf-card p-6">
                        <span class="grid h-11 w-11 place-items-center rounded-xl border border-white/10 bg-white/5">
                            <svg class="h-5 w-5 text-fuchsia-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d={f.icon} />
                            </svg>
                        </span>
                        <h3 class="mt-4 text-lg font-semibold">{f.t}</h3>
                        <p class="mt-1.5 text-sm text-white/60">{f.d}</p>
                    </div>
                ))
            }
        </div>

        <dl class="mt-12 grid grid-cols-2 gap-6 rounded-2xl border border-white/10 bg-white/[0.02] p-8 sm:grid-cols-4">
            {
                stats.map((s) => (
                    <div>
                        <dt class="text-3xl font-semibold tracking-tight sm:text-4xl">{s.v}</dt>
                        <dd class="mt-1 text-sm text-white/60">{s.l}</dd>
                    </div>
                ))
            }
        </dl>
    </section>

    <!-- security band -->
    <section class="border-y border-white/10 bg-white/[0.02] py-16">
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
            <div class="grid items-center gap-10 lg:grid-cols-2">
                <div>
                    <p class="hf-eyebrow">Security &amp; compliance</p>
                    <h2 class="mt-3 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
                        Enterprise-grade by default
                    </h2>
                    <p class="mt-4 max-w-lg text-white/60">
                        Encryption in transit and at rest, audited access, and independent certifications — so security
                        review is a formality, not a blocker.
                    </p>
                </div>
                <div class="flex flex-wrap gap-2.5">
                    {compliance.map((c) => <span class="hf-chip">{c}</span>)}
                </div>
            </div>
        </div>
    </section>

    <!-- contact -->
    <section id="contact" class="mx-auto max-w-7xl scroll-mt-20 px-5 py-20 sm:px-8">
        <div class="grid gap-10 lg:grid-cols-2">
            <div>
                <h2 class="text-balance text-4xl font-semibold tracking-tight sm:text-5xl">Let's talk scale</h2>
                <p class="mt-4 max-w-md text-lg text-white/60">
                    Tell us about your team and we'll put together a tailored plan, a live demo and a security overview.
                </p>
                <ul class="mt-8 flex flex-col gap-3 text-sm text-white/70">
                    <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-fuchsia-400"></span> Dedicated solutions engineer</li>
                    <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-fuchsia-400"></span> Custom onboarding &amp; training</li>
                    <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-fuchsia-400"></span> Volume &amp; committed-use pricing</li>
                </ul>
            </div>

            <form id="hf-contact" class="hf-card p-6 sm:p-7" novalidate>
                <div class="grid gap-4 sm:grid-cols-2">
                    <label class="flex flex-col gap-1.5 text-sm">
                        <span class="text-white/70">Full name</span>
                        <input required name="name" autocomplete="name" class="hf-field" />
                    </label>
                    <label class="flex flex-col gap-1.5 text-sm">
                        <span class="text-white/70">Work email</span>
                        <input required type="email" name="email" autocomplete="email" class="hf-field" />
                    </label>
                    <label class="flex flex-col gap-1.5 text-sm sm:col-span-2">
                        <span class="text-white/70">Company</span>
                        <input name="company" autocomplete="organization" class="hf-field" />
                    </label>
                    <label class="flex flex-col gap-1.5 text-sm sm:col-span-2">
                        <span class="text-white/70">What are you building?</span>
                        <textarea name="message" rows="3" class="hf-field resize-none"></textarea>
                    </label>
                </div>
                <button type="submit" class="hf-btn hf-btn-primary mt-5 w-full">Request access</button>
                <p id="hf-contact-status" class="mt-3 hidden text-sm text-emerald-400" role="status"></p>
                <p class="mt-3 text-xs text-white/30">Demo form — submissions are handled in your browser and not sent anywhere.</p>
            </form>
        </div>

        <div class="mt-16">
            <h2 class="mb-6 text-2xl font-semibold sm:text-3xl">Enterprise FAQ</h2>
            <Faq items={faqs} />
        </div>
    </section>
</SiteLayout>

<script>
    const form = document.getElementById('hf-contact') as HTMLFormElement | null;
    const status = document.getElementById('hf-contact-status');
    form?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }
        const name = (new FormData(form).get('name') as string) || 'there';
        form.querySelectorAll('input, textarea, button').forEach((el) => ((el as HTMLInputElement).disabled = true));
        if (status) {
            status.textContent = `Thanks, ${name.split(' ')[0]} — we'll be in touch shortly. (Demo: nothing was sent.)`;
            status.classList.remove('hidden');
        }
    });
</script>
