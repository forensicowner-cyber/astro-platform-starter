---
import SalesLayout from '../layouts/SalesLayout.astro';
import Nav from '../components/sell/Nav.astro';
import SellFooter from '../components/sell/SellFooter.astro';
import Reveal from '../components/sell/Reveal.astro';
---

<SalesLayout title="Privacy Policy — NovaPro">
    <Nav />

    <section class="sell-section pt-12">
        <div class="sell-container max-w-3xl">
            <Reveal>
                <span class="sell-eyebrow">Legal</span>
                <h1 class="mt-5 text-4xl sm:text-5xl font-bold text-white">Privacy Policy</h1>
                <p class="mt-3 text-sm text-[color:var(--color-sell-muted)]">Last updated: January 2026</p>
            </Reveal>

            <div class="sell-prose mt-10 space-y-8 text-[color:var(--color-sell-text)]/90">
                <Reveal delay={1}>
                    <h2 class="text-xl font-semibold text-white">1. What we collect</h2>
                    <p class="mt-3 leading-relaxed">
                        We collect the information you provide when you sign up — your name, email, and payment details. We also collect basic usage data (page views, click events) to make the product better.
                    </p>
                </Reveal>
                <Reveal delay={1}>
                    <h2 class="text-xl font-semibold text-white">2. How we use it</h2>
                    <p class="mt-3 leading-relaxed">
                        Strictly to deliver the service: account management, billing, support, security, and product improvements. We never sell your data. Period.
                    </p>
                </Reveal>
                <Reveal delay={1}>
                    <h2 class="text-xl font-semibold text-white">3. Data security</h2>
                    <p class="mt-3 leading-relaxed">
                        All data is encrypted in transit (TLS 1.3) and at rest (AES-256). Payment information is handled by PCI-DSS Level 1 certified providers. We never store full card numbers.
                    </p>
                </Reveal>
                <Reveal delay={1}>
                    <h2 class="text-xl font-semibold text-white">4. Your rights</h2>
                    <p class="mt-3 leading-relaxed">
                        You can request a copy of your data, correct it, or delete it at any time. Email us at <a href="mailto:privacy@novapro.app" class="text-white">privacy@novapro.app</a> and we'll respond within 7 days.
                    </p>
                </Reveal>
                <Reveal delay={1}>
                    <h2 class="text-xl font-semibold text-white">5. Cookies</h2>
                    <p class="mt-3 leading-relaxed">
                        We use only essential cookies (login session, security) and anonymous analytics. No third-party tracking, no ad pixels.
                    </p>
                </Reveal>
                <Reveal delay={1}>
                    <h2 class="text-xl font-semibold text-white">6. Contact</h2>
                    <p class="mt-3 leading-relaxed">
                        Questions? Reach us at <a href="mailto:hello@novapro.app" class="text-white">hello@novapro.app</a>.
                    </p>
                </Reveal>
            </div>
        </div>
    </section>

    <SellFooter />
</SalesLayout>
