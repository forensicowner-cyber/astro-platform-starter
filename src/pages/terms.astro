---
import SalesLayout from '../layouts/SalesLayout.astro';
import Nav from '../components/sell/Nav.astro';
import SellFooter from '../components/sell/SellFooter.astro';
import Reveal from '../components/sell/Reveal.astro';
---

<SalesLayout title="Terms of Service — NovaPro">
    <Nav />

    <section class="sell-section pt-12">
        <div class="sell-container max-w-3xl">
            <Reveal>
                <span class="sell-eyebrow">Legal</span>
                <h1 class="mt-5 text-4xl sm:text-5xl font-bold text-white">Terms of Service</h1>
                <p class="mt-3 text-sm text-[color:var(--color-sell-muted)]">Last updated: January 2026</p>
            </Reveal>

            <div class="sell-prose mt-10 space-y-8 text-[color:var(--color-sell-text)]/90">
                <Reveal delay={1}>
                    <h2 class="text-xl font-semibold text-white">1. Your account</h2>
                    <p class="mt-3 leading-relaxed">
                        You're responsible for keeping your login credentials secure and for all activity on your account. Don't share your password.
                    </p>
                </Reveal>
                <Reveal delay={1}>
                    <h2 class="text-xl font-semibold text-white">2. Acceptable use</h2>
                    <p class="mt-3 leading-relaxed">
                        You agree not to use NovaPro for anything illegal — fraud, spam, malware distribution, or selling restricted goods. We reserve the right to suspend accounts that violate this.
                    </p>
                </Reveal>
                <Reveal delay={1}>
                    <h2 class="text-xl font-semibold text-white">3. Billing</h2>
                    <p class="mt-3 leading-relaxed">
                        Paid plans are billed monthly or annually in advance. Trials convert to paid plans at the price shown at sign-up. Cancel anytime — no questions, no fees.
                    </p>
                </Reveal>
                <Reveal delay={1}>
                    <h2 class="text-xl font-semibold text-white">4. Refunds</h2>
                    <p class="mt-3 leading-relaxed">
                        We offer a 30-day money-back guarantee on all paid plans. Email us, and we'll refund you in full — no hassle.
                    </p>
                </Reveal>
                <Reveal delay={1}>
                    <h2 class="text-xl font-semibold text-white">5. Your content</h2>
                    <p class="mt-3 leading-relaxed">
                        Anything you upload (products, images, copy) remains 100% yours. We only use it to provide the service. Export your data anytime in standard formats.
                    </p>
                </Reveal>
                <Reveal delay={1}>
                    <h2 class="text-xl font-semibold text-white">6. Liability</h2>
                    <p class="mt-3 leading-relaxed">
                        NovaPro is provided "as is". We work hard to keep it running smoothly, but we can't guarantee 100% uptime. Our total liability is capped at the amount you've paid us in the last 12 months.
                    </p>
                </Reveal>
                <Reveal delay={1}>
                    <h2 class="text-xl font-semibold text-white">7. Contact</h2>
                    <p class="mt-3 leading-relaxed">
                        Questions about these terms? Email <a href="mailto:legal@novapro.app" class="text-white">legal@novapro.app</a>.
                    </p>
                </Reveal>
            </div>
        </div>
    </section>

    <SellFooter />
</SalesLayout>
